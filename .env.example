# ArthillesBot SaaS - copie para backend/.env em desenvolvimento local

NODE_ENV=development
BACKEND_PORT=3001
PORT=3001
LOG_LEVEL=info

# URLs publicas
BACKEND_PUBLIC_URL=http://localhost:3001
DASHBOARD_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Autenticacao do painel
AUTH_SECRET=change_me_auth_secret
ALLOW_BOOTSTRAP_LOGIN=true
ADMIN_EMAIL=admin@arthilles.local
ADMIN_PASSWORD=admin123
DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001
WEBHOOK_SHARED_SECRET=

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=cole_a_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Evolution API
EVOLUTION_API_URL=https://sua-evolution-api.exemplo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=arthilles-demo

# Google Sheets FAQ
GOOGLE_SHEETS_CSV_URL=
