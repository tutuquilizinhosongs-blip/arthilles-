# ArthillesBot - local development defaults

COMPOSE_PROJECT_NAME=arthilles

# Shared
NODE_ENV=development
TZ=America/Sao_Paulo

# PostgreSQL
POSTGRES_DB=arthillesbot
POSTGRES_N8N_DB=arthilles_n8n
POSTGRES_USER=arthilles
POSTGRES_PASSWORD=change_me_local_password
DATABASE_URL=postgresql://arthilles:change_me_local_password@postgres:5432/arthillesbot
EVOLUTION_DATABASE_URL=postgresql://arthilles:change_me_local_password@postgres:5432/arthilles_evolution

# Redis
REDIS_URL=redis://redis:6379

# Backend
BACKEND_PORT=3001
BACKEND_PUBLIC_URL=http://localhost:3001
DASHBOARD_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info
ADMIN_API_KEY=change_me_admin_key
WEBHOOK_SHARED_SECRET=change_me_webhook_secret

# Evolution API
EVOLUTION_PORT=8080
EVOLUTION_API_KEY=change_me_evolution_key
EVOLUTION_INSTANCE_NAME=arthilles
EVOLUTION_WEBHOOK_URL=http://backend:3001/webhook/evolution

# n8n
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_n8n_password
N8N_ENCRYPTION_KEY=change_me_32_chars_minimum_key_here

# Dashboard
DASHBOARD_PORT=3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://ollama:11434
